      <path style="fill:var(--pink);stroke:var(--pink-deep);stroke-width:2.2;stroke-linejoin:round" d="M60 38 C40 2 3 8 8 36 C11 62 42 62 60 42 Z M60 38 C80 2 117 8 112 36 C109 62 78 62 60 42 Z"/>
