<title>photobooth hd parah</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Parisienne&family=Dancing+Script:wght@500;700&family=Quicksand:wght@500;700&display=swap">
<style>
/* Layout: satu kolom di tengah panggung gingham pink. Judul, kotak kado dengan bow, tiga hati penghitung ketukan.
   Surat naik dari kotak ke lapisan layar penuh. Tampilan sengaja satu tema (pink terang) agar bow dan mutiara tetap manis. */
:root {
  color-scheme: light;
  --bg: #ffe3ec;
  --glow: #fff6f9;
  --check: rgba(255, 143, 177, 0.2);
  --pink: #ff8fb1;
  --pink-soft: #ffb3c9;
  --pink-pale: #ffd6e3;
  --pink-deep: #e8618c;
  --cherry: #c9314f;
  --berry: #c93a6e;
  --cream: #fff8f2;
  --text: #a02e5c;
  --text-soft: #8a3f5c;
  --ink: #7a3b55;
  --paper: #fffaf6;
  --rule: rgba(255, 143, 177, 0.28);
  --margin-line: #ffb3c9;
  --font-display: "Parisienne", "Brush Script MT", cursive;
  --font-hand: "Dancing Script", "Segoe Script", cursive;
  --font-ui: "Quicksand", system-ui, "Segoe UI", sans-serif;
}
 
html, body { height: 100%; }
body {
  margin: 0;
  font-size: 1rem;
  font-family: var(--font-ui);
  color: var(--text);
  background-color: var(--bg);
  background-image:
    radial-gradient(70% 55% at 50% 55%, var(--glow) 0%, rgba(255, 246, 249, 0) 100%),
    linear-gradient(90deg, var(--check) 50%, transparent 50%),
    linear-gradient(var(--check) 50%, transparent 50%);
  background-size: auto, 36px 36px, 36px 36px;
  overflow-x: hidden;
}
 
.defs { position: absolute; width: 0; height: 0; overflow: hidden; }
 
.stage {
  box-sizing: border-box;
  min-height: 100%;
  display: grid;
  align-content: center;
  justify-items: center;
  gap: clamp(14px, 3.5vh, 26px);
  padding-block: 24px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  text-align: center;
}
 
h1 {
  margin: 0;
  max-width: 11em;
  font: 400 clamp(2.5rem, 12vw, 4.2rem) / 1.1 var(--font-display);
  text-wrap: balance;
  color: var(--text);
  text-shadow: 0 2px 0 var(--cream);
}
 
/* Kotak kado */
.gift-btn {
  --w: clamp(210px, 64vw, 300px);
  width: var(--w);
  padding: 0;
  margin: 0;
  border: 0;
  background: none;
  cursor: pointer;
  border-radius: 24px;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
.gift-btn:disabled { cursor: default; }
.gift-btn:focus-visible { outline: 3px solid var(--pink-deep); outline-offset: 8px; }
 
.gift-svg { display: block; width: 100%; height: auto; overflow: visible; }
.bobber { animation: bob 3.2s ease-in-out infinite; }
.gift-svg.open .bobber { animation: none; }
.lid { transform-box: fill-box; transform-origin: 50% 100%; transition: transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1); }
.gift-svg.lift .lid { transform: translateY(-12px) rotate(-4deg); }
.gift-svg.open .lid { animation: lidfly 1s cubic-bezier(0.2, 0.7, 0.3, 1) forwards; }
 
@keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@keyframes lidfly {
  0%   { transform: translateY(-12px) rotate(-4deg); opacity: 1; }
  35%  { transform: translate(-6px, -70px) rotate(-10deg); opacity: 1; }
  100% { transform: translate(70px, -210px) rotate(34deg); opacity: 0; }
}
.shake1 { animation: shake1 0.45s ease-in-out; }
.shake2 { animation: shake2 0.6s ease-in-out; }
@keyframes shake1 {
  0%, 100% { transform: none; }
  20% { transform: translateX(-5px) rotate(-2deg); }
  40% { transform: translateX(5px) rotate(2deg); }
  60% { transform: translateX(-3px) rotate(-1deg); }
  80% { transform: translateX(3px) rotate(1deg); }
}
@keyframes shake2 {
  0%, 100% { transform: none; }
  15% { transform: translate(-9px, -6px) rotate(-4deg); }
  35% { transform: translate(9px, 0) rotate(4deg); }
  55% { transform: translate(-7px, -5px) rotate(-3deg); }
  75% { transform: translate(6px, 0) rotate(2deg); }
}
 
/* Hitungan ketukan: tiga hati */
.dots { display: flex; gap: 10px; }
.dot {
  width: 26px; height: 26px;
  fill: none;
  stroke: var(--pink-deep);
  stroke-width: 2;
  stroke-linejoin: round;
  transition: fill 0.2s, transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
}
.dot.on { fill: var(--pink-deep); transform: scale(1.18); }
 
.hint {
  margin: 0;
  min-height: 1.5em;
  font: 700 1.05rem / 1.4 var(--font-ui);
  color: var(--text-soft);
}
 
.actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
.btn {
  font: 700 1rem / 1.2 var(--font-ui);
  padding: 0.8em 1.5em;
  border-radius: 999px;
  border: 2px solid var(--berry);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.btn:focus-visible { outline: 3px solid var(--pink-deep); outline-offset: 3px; }
.btn-primary { background: var(--berry); color: #fff; box-shadow: 0 3px 0 #8f2450; }
.btn-ghost { background: var(--cream); color: var(--text); }
.btn-ink { background: var(--cream); color: var(--text); }
 
/* Lapisan surat */
.layer {
  position: fixed; inset: 0; z-index: 20;
  display: grid; place-items: center;
  box-sizing: border-box;
  padding: calc(16px + env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) calc(16px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  background: rgba(255, 227, 236, 0.78);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  visibility: hidden; opacity: 0;
  transition: opacity 0.35s ease, visibility 0s linear 0.35s;
}
.layer.show { visibility: visible; opacity: 1; transition: opacity 0.35s ease; }
 
.letter {
  box-sizing: border-box;
  width: min(100%, 430px);
  max-height: 100%;
  overflow-y: auto;
  padding: 30px 24px 34px 52px;
  color: var(--ink);
  border: 3px dotted var(--pink);
  border-radius: 20px;
  background:
    linear-gradient(90deg, transparent 0 38px, var(--margin-line) 38px 39.5px, transparent 39.5px),
    repeating-linear-gradient(to bottom, transparent 0 33px, var(--rule) 33px 34px),
    var(--paper);
  background-color: var(--paper);
  background-attachment: local;
  box-shadow: 0 20px 50px rgba(201, 58, 110, 0.28);
  transform: translateY(22vh) scale(0.28) rotate(-8deg);
  transform-origin: 50% 100%;
  opacity: 0;
  transition: transform 0.95s cubic-bezier(0.22, 1.15, 0.36, 1), opacity 0.3s ease;
}
.layer.show .letter { transform: none; opacity: 1; transition-delay: 0.35s, 0.35s; }
 
.letter-bow { display: block; width: 102px; height: 68px; margin: 0 auto 0 -6px; }
.letter .to { margin: 0; font: 700 1.5rem / 34px var(--font-hand); color: var(--berry); }
.letter h2 { margin: 0; font: 400 3rem / 68px var(--font-display); color: var(--text); text-wrap: balance; }
.letter p { margin: 0 0 34px; font: 500 1.4rem / 34px var(--font-hand); }
.letter .sign { margin: 0 0 34px; }
.letter .sign strong { display: block; font-weight: 700; color: var(--berry); }
 
.layer.show .letter [data-i] { animation: fadeUp 0.6s ease both; animation-delay: calc(0.9s + var(--i) * 0.22s); }
@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
 
#fx { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 30; pointer-events: none; }
 
@media (prefers-reduced-motion: reduce) {
  .bobber, .shake1, .shake2 { animation: none; }
  .gift-svg.open .lid { animation: none; opacity: 0; }
  .lid, .dot { transition: none; }
  .letter { transform: none; transition: opacity 0.3s ease; }
  .layer.show .letter { transition-delay: 0s; }
  .layer.show .letter [data-i] { animation: none; }
}
</style>
 
