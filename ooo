<script>
(function () {
  // Isi nama di sini kalau ingin ucapan lebih personal.
  var TO = "";
  var FROM = "";
 
  var $ = function (id) { return document.getElementById(id); };
  var btn = $("gift"), svg = $("giftSvg"), hint = $("hint"), actions = $("actions");
  var layer = $("layer"), closeBtn = $("closeBtn"), readBtn = $("readBtn"), againBtn = $("againBtn");
  var dots = Array.prototype.slice.call(document.querySelectorAll(".dot"));
  var cv = $("fx"), ctx = cv.getContext("2d");
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
 
  if (TO) {
    $("title").textContent = "Ada kado untuk " + TO;
    $("to").textContent = "Untuk " + TO + ",";
  }
 
  var HINTS = ["Ketuk kotaknya 3 kali ya", "Yay, dua kali lagi", "Satu lagi, hampir kebuka!", ""];
  var taps = 0, busy = false, opened = false;
 
  function renderDots() {
    dots.forEach(function (d, i) { d.classList.toggle("on", taps > i); });
  }
  function shake(cls) {
    btn.classList.remove("shake1", "shake2");
    void btn.offsetWidth;
    btn.classList.add(cls);
  }
  btn.addEventListener("animationend", function (e) {
    if (e.target === btn) btn.classList.remove("shake1", "shake2");
  });
 
  btn.addEventListener("click", function () {
    if (opened || busy) return;
    taps++;
    renderDots();
    hint.textContent = HINTS[taps];
    if (taps === 1) {
      shake("shake1");
    } else if (taps === 2) {
      shake("shake2");
      svg.classList.add("lift");
    } else {
      busy = true;
      shake("shake2");
      svg.classList.add("lift");
      setTimeout(openGift, reduce.matches ? 0 : 330);
    }
  });
 
  function openGift() {
    opened = true;
    busy = false;
    btn.disabled = true;
    svg.classList.add("open");
    if (!reduce.matches) {
      burst(130, 34);
      setTimeout(function () { burst(60, 12); }, 450);
    }
    setTimeout(showLetter, reduce.matches ? 0 : 300);
  }
 
  function showLetter() {
    layer.classList.add("show");
    layer.setAttribute("aria-hidden", "false");
    closeBtn.focus({ preventScroll: true });
  }
  function hideLetter() {
    if (!layer.classList.contains("show")) return;
    layer.classList.remove("show");
    layer.setAttribute("aria-hidden", "true");
    actions.hidden = false;
    hint.textContent = "Kadonya sudah terbuka";
    readBtn.focus({ preventScroll: true });
  }
  function reset() {
    layer.classList.remove("show");
    layer.setAttribute("aria-hidden", "true");
    taps = 0; opened = false; busy = false;
    btn.disabled = false;
    svg.classList.remove("open", "lift");
    renderDots();
    hint.textContent = HINTS[0];
    actions.hidden = true;
    parts.length = 0;
    ctx.clearRect(0, 0, W, H);
    btn.focus({ preventScroll: true });
  }
 
  closeBtn.addEventListener("click", hideLetter);
  layer.addEventListener("click", function (e) { if (e.target === layer) hideLetter(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") hideLetter(); });
  readBtn.addEventListener("click", showLetter);
  againBtn.addEventListener("click", reset);
 
  /* Ledakan bow, hati, mutiara, dan pita satin */
  var W = 0, H = 0, DPR = 1, parts = [], raf = 0, last = 0;
  var PINKS = ["#ffb3c9", "#ff8fb1", "#ffd6e3", "#fff8f2", "#f7a1bd", "#e8618c", "#ffc9d9", "#c9314f"];
  var STREAM = ["#ffb3c9", "#ff8fb1", "#ffd6e3", "#fff8f2", "#f7a1bd", "#e8618c"];
  var EDGE = "rgba(201,49,79,0.32)";
  var BOW = new Path2D("M54 46 L36 76 L49 70 L56 78 L62 50 Z M66 46 L84 76 L71 70 L64 78 L58 50 Z M60 38 C40 2 3 8 8 36 C11 62 42 62 60 42 Z M60 38 C80 2 117 8 112 36 C109 62 78 62 60 42 Z");
  var HEART = new Path2D("M0 8 C-12 0 -10 -9 -4 -9 C-1 -9 0 -6 0 -5 C0 -6 1 -9 4 -9 C10 -9 12 0 0 8 Z");
 
  function size() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth; H = window.innerHeight;
    cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  window.addEventListener("resize", size);
  size();
 
  function rnd(a, b) { return a + Math.random() * (b - a); }
  function pickFrom(arr) { return arr[(Math.random() * arr.length) | 0]; }
 
  function burst(nConfetti, nStreamers) {
    var r = svg.getBoundingClientRect();
    var ox = r.left + r.width / 2, oy = r.top + r.height * 0.42;
    var k = Math.max(0.75, Math.min(1.25, H / 760));
    var i, a, sp, roll, kind;
    for (i = 0; i < nConfetti; i++) {
      a = -Math.PI / 2 + rnd(-1, 1) * 1.05;
      sp = rnd(8, 19) * k;
      roll = Math.random();
      kind = roll < 0.34 ? "h" : roll < 0.58 ? "p" : roll < 0.74 ? "b" : "c";
      parts.push({
        t: kind, x: ox + rnd(-30, 30), y: oy,
        vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
        s: kind === "b" ? rnd(0.2, 0.34) : kind === "h" ? rnd(0.7, 1.25) : rnd(3.5, 6),
        w: rnd(6, 10), h: rnd(10, 16),
        rot: rnd(0, 6.28), vr: rnd(-0.25, 0.25), rot0: rnd(-0.5, 0.5),
        ph: rnd(0, 6.28), vph: rnd(0.1, 0.28),
        col: kind === "p" ? "#fffaf6" : pickFrom(PINKS), life: 0
      });
    }
    for (i = 0; i < nStreamers; i++) {
      a = -Math.PI / 2 + rnd(-1, 1) * 0.9;
      sp = rnd(9, 18) * k;
      parts.push({
        t: "s", x: ox + rnd(-20, 20), y: oy,
        vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
        pts: [], col: pickFrom(STREAM), lw: rnd(3.5, 6),
        ph: rnd(0, 6.28), vph: rnd(0.12, 0.22), amp: rnd(0.5, 1.3), life: 0
      });
    }
    if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
  }
 
  function frame(t) {
    var dt = Math.min((t - last) / 16.667, 2.5);
    last = t;
    ctx.clearRect(0, 0, W, H);
    var i, p, j, alpha;
    for (i = parts.length - 1; i >= 0; i--) {
      p = parts[i];
      p.life += dt;
      alpha = p.life > 340 ? Math.max(0, 1 - (p.life - 340) / 80) : 1;
      if (p.y > H + 60 || alpha <= 0) { parts.splice(i, 1); continue; }
 
      if (p.t !== "s") {
        p.vy += 0.3 * dt;
        p.vx *= Math.pow(0.972, dt);
        p.vy *= Math.pow(0.972, dt);
        p.ph += p.vph * dt;
        p.x += (p.vx + Math.sin(p.ph) * 0.7) * dt;
        p.y += p.vy * dt;
        p.rot += p.vr * dt;
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.translate(p.x, p.y);
        if (p.t === "c") {
          ctx.rotate(p.rot);
          ctx.scale(1, Math.cos(p.ph));
          ctx.fillStyle = p.col;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
        } else if (p.t === "p") {
          ctx.fillStyle = p.col;
          ctx.strokeStyle = "rgba(232,97,140,0.45)";
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.arc(0, 0, p.s, 0, 6.2832); ctx.fill(); ctx.stroke();
          ctx.fillStyle = "rgba(255,255,255,0.95)";
          ctx.beginPath(); ctx.arc(-p.s * 0.3, -p.s * 0.3, p.s * 0.3, 0, 6.2832); ctx.fill();
        } else if (p.t === "h") {
          ctx.rotate(p.rot0 + Math.sin(p.ph) * 0.5);
          ctx.scale(p.s, p.s);
          ctx.fillStyle = p.col;
          ctx.strokeStyle = EDGE;
          ctx.lineWidth = 1.2 / p.s;
          ctx.lineJoin = "round";
          ctx.fill(HEART); ctx.stroke(HEART);
        } else {
          ctx.rotate(p.rot0 + Math.sin(p.ph) * 0.45);
          ctx.scale(p.s, p.s);
          ctx.translate(-60, -42);
          ctx.fillStyle = p.col;
          ctx.strokeStyle = EDGE;
          ctx.lineWidth = 2 / p.s;
